# FIELD POS server-side environment
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PUBLIC_ORIGIN=https://your-field-pos.example

# Database environment safety marker.
# Production: production
# Vercel Preview/UAT: uat (Preview API fails closed unless this is exactly "uat")
FIELD_DB_SCOPE=production

# PromptPay provider — keep Playground until FIELD merchant approval + end-to-end test pass
PROMPTPAY_PROVIDER=beam
BEAM_ENV=playground
# Required before PromptPay is enabled in POS:
BEAM_MERCHANT_ID=
BEAM_API_KEY=
BEAM_WEBHOOK_HMAC_KEY=

# Optional legacy fallback during migration
# OMISE_SECRET_KEY=

# Optional kitchen notifications; never expose these to the browser
LINE_CHANNEL_ACCESS_TOKEN=
LINE_KITCHEN_GROUP_ID=
LINE_CHANNEL_SECRET=
