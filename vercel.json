{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/pos",
      "permanent": false
    },
    {
      "source": "/online.js",
      "destination": "/pos",
      "permanent": false
    },
    {
      "source": "/online-v2.js",
      "destination": "/pos",
      "permanent": false
    },
    {
      "source": "/fast-ui.js",
      "destination": "/pos",
      "permanent": false
    }
  ]
}
